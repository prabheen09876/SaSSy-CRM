# Local sandbox: no connection to an existing business or production system.
VITE_CRM_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WORKER_URL=
# Shared live deployment connections are locked by default.
# Use true only for a deliberate operator/development setup installation.
VITE_ALLOW_CONNECTION_SETUP=false
# SaaS: VITE_CRM_MODE=saas with a NEW project using supabase/saas.sql.
# Dedicated business: VITE_CRM_MODE=supabase with standalone.sql instead.
# Optional public Web Push key; requires your own integration service.
VITE_VAPID_PUBLIC_KEY=
